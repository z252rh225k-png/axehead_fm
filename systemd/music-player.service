[Unit]
Description=Analog Music Player Service
After=network.target
# Use 'pipewire.service' only if it's a system service. 
# Since we are using user-scoped PipeWire, remove 'Requires=pipewire.service' 
# from the systemd unit and rely on the socket activation.
# Requires=dev-bus-usb.device
# After=dev-bus-usb.device

[Service]
Type=simple
User=user
WorkingDirectory=/opt/music-player
ExecStart=/opt/music-player/venv/bin/python -m music_player.player
StandardOutput=append:/opt/music-player/logs/music-player.log
StandardError=append:/opt/music-player/logs/music-player.log

# Python execution rules
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

# Audio & PipeWire socket routing
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=PULSE_SERVER=unix:/run/user/1000/pulse/native
Environment=SDL_AUDIODRIVER=pulseaudio
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus

Restart=always
RestartSec=5

# Access to audio hardware and GPIO
SupplementaryGroups=audio gpio i2c dialout

[Install]
WantedBy=multi-user.target