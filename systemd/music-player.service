[Unit]
Description=Analog Music Player Service
After=sound.target network.target
Requires=sound.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/music-player
ExecStart=/opt/music-player/venv/bin/music-player
StandardOutput=append:/opt/music-player/logs/music-player.log
StandardError=append:/opt/music-player/logs/music-player.log

Environment=PYTHONUNBUFFERED=1

# 💡 CHANGE TO THIS: Force Pygame to talk straight to the ALSA hardware layer
Environment=SDL_AUDIODRIVER=alsa

Restart=always
RestartSec=5

# This group list gives the service direct access to the soundcard hardware channels
SupplementaryGroups=audio gpio i2c dialout

[Install]
WantedBy=multi-user.target