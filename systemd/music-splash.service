[Unit]
Description=Music Player Boot Splash Screen
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target

[Service]
Type=simple
RemainAfterExit=no
User=user
ExecStart=/opt/music-player/venv/bin/python -m music_player.splash
ExecStop=/opt/music-player/venv/bin/python -m music_player.splash stop

Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=sysinit.target
