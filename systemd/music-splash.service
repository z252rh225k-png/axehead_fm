[Unit]
Description=Music Player Boot/Shutdown Splash Screen
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/music-player/venv/bin/music-splash
ExecStop=/opt/music-player/venv/bin/music-splash stop

[Install]
WantedBy=sysinit.target
